# Copy to .env for local development. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
# Leave unset to use a local SQLite file. For Postgres: postgresql://user:pass@host/dbname
# DATABASE_URL=
SITE_URL=http://127.0.0.1:5000
ADMIN_EMAILS=you@thapar.edu
CAMPUSES=Thapar Institute of Engineering & Technology (TIET), Patiala
ALLOWED_EMAIL_DOMAINS=thapar.edu
MATCH_TIME_WINDOW_HOURS=3
APP_TIMEZONE=Asia/Kolkata

# Email. With none of these set, codes are shown on screen (dev mode, local only).
# Online (Render free plan blocks SMTP): Gmail API, see README "Email (Gmail)". About 500 emails/day, free.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=Travel Buddy <you@gmail.com>
# Or Brevo's API instead of Gmail: BREVO_API_KEY from Brevo > SMTP & API > API keys.
BREVO_API_KEY=
# SMTP instead (works locally, not on Render free): Brevo smtp-relay.brevo.com / 587 with login + SMTP key.
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
