# Copy to .env for local development. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
# Leave unset to use a local SQLite file. For Postgres: postgresql://user:pass@host/dbname
# DATABASE_URL=
SITE_URL=http://127.0.0.1:5000
ADMIN_EMAILS=you@thapar.edu
CAMPUSES=Thapar Institute of Engineering & Technology (TIET), Patiala
ALLOWED_EMAIL_DOMAINS=thapar.edu
MATCH_TIME_WINDOW_HOURS=3
APP_TIMEZONE=Asia/Kolkata

# Email. Without MAIL_USERNAME, codes are shown on screen (dev mode).
# Brevo: smtp-relay.brevo.com / 587, login + SMTP key from Brevo > SMTP & API.
# Resend: smtp.resend.com / 587, username "resend", password = API key.
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Travel Buddy <noreply@example.com>

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
